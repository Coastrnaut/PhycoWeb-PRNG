# Auto detect text files and perform LF normalization
* text=auto
# Fixed line endings for every file whose SHA-256 is recorded in the repository, and for scripts,
# so that a fresh checkout on any platform reproduces the recorded hashes and runs in WSL.
# Checked on 2026-10-31 against every hash cited in the repository.
*.py text eol=lf
*.ps1 text eol=lf
*.c text eol=lf
*.h text eol=lf
*.sh text eol=lf
.claude/skills/** text eol=lf
.specify/.gitignore text eol=lf
.specify/templates/** text eol=lf
specs/002-core-dynamics-redesign/design.md text eol=lf
reports/003-extended-batteries-calibration/calibration/runs/SHA256SUMS text eol=lf
reports/003-extended-batteries-calibration/calibration/summary.json text eol=lf
reports/003-extended-batteries-calibration/calibration/summary.md text eol=lf
# These two freeze records were written on Windows: their recorded SHA-256 is over CRLF bytes.
reports/002-core-dynamics-redesign/attempt-1/freeze.json text eol=crlf
reports/003-extended-batteries-calibration/attempt-1/freeze.json text eol=crlf
baseline/** -text
# Feature 004: every report file, every research file and the protocol's JSON files are LF, since
# records hold their hashes. Later lines take precedence, so the binary rules below still apply
# inside them, and compressed records are never treated as text.
reports/004-crypto-architecture-v3/** text eol=lf
research/004/** text eol=lf
protocol/*.json text eol=lf
specs/004-crypto-architecture-v3/**/*.md text eol=lf
vectors/phyco-v3/** text eol=lf
# Feature 005: its documents are LF too, since its records will hold their hashes, as feature 004's do.
specs/005-crypto-architecture-v4/**/*.md text eol=lf
reports/005-crypto-architecture-v4/** text eol=lf
research/005/** text eol=lf
# Local-only outputs stay as written: git ignores them, and committed records hold their hashes.
data/local/** -text
*.mk text eol=lf
Makefile text eol=lf
*.hex text eol=lf
*.bin binary
*.gz binary
# Feature 004: the binaries each C tool builds beside its source, whose hashes records hold.
**/build/** binary
